<?xml version="1.0"?>
<robot name="quadcopter_drone">

  <!-- ============================================
       MAIN BODY (Central Frame)
       ============================================ -->
  
  <link name="base_link">
    <visual>
      <geometry>
        <box size="0.33 0.33 0.05"/>
      </geometry>
      <material name="blue"/>
    </visual>
    
    <collision>
      <geometry>
        <box size="0.33 0.33 0.05"/>
      </geometry>
    </collision>
    
    <inertial>
      <mass value="1.5"/>
      <inertia
        ixx="0.02" ixy="0.0" ixz="0.0"
        iyy="0.02" iyz="0.0"
        izz="0.04"/>
    </inertial>
  </link>

  <!-- Motor 1: Front-Right -->
  <link name="motor_1">
    <visual>
      <geometry>
        <cylinder length="0.02" radius="0.02"/>
      </geometry>
      <material name="red"/>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.02" radius="0.02"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.00001" ixy="0.0" ixz="0.0"
               iyy="0.00001" iyz="0.0"
               izz="0.00001"/>
    </inertial>
  </link>

  <joint name="motor_1_joint" type="continuous">
    <parent link="base_link"/>
    <child link="motor_1"/>
    <origin xyz="0.1075 -0.1075 0.03" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <!-- Motor 2: Front-Left -->
  <link name="motor_2">
    <visual>
      <geometry>
        <cylinder length="0.02" radius="0.02"/>
      </geometry>
      <material name="red"/>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.02" radius="0.02"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.00001" ixy="0.0" ixz="0.0"
               iyy="0.00001" iyz="0.0"
               izz="0.00001"/>
    </inertial>
  </link>

  <joint name="motor_2_joint" type="continuous">
    <parent link="base_link"/>
    <child link="motor_2"/>
    <origin xyz="0.1075 0.1075 0.03" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <!-- Motor 3: Rear-Left -->
  <link name="motor_3">
    <visual>
      <geometry>
        <cylinder length="0.02" radius="0.02"/>
      </geometry>
      <material name="red"/>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.02" radius="0.02"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.00001" ixy="0.0" ixz="0.0"
               iyy="0.00001" iyz="0.0"
               izz="0.00001"/>
    </inertial>
  </link>

  <joint name="motor_3_joint" type="continuous">
    <parent link="base_link"/>
    <child link="motor_3"/>
    <origin xyz="-0.1075 0.1075 0.03" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <!-- Motor 4: Rear-Right -->
  <link name="motor_4">
    <visual>
      <geometry>
        <cylinder length="0.02" radius="0.02"/>
      </geometry>
      <material name="red"/>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.02" radius="0.02"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.00001" ixy="0.0" ixz="0.0"
               iyy="0.00001" iyz="0.0"
               izz="0.00001"/>
    </inertial>
  </link>

  <joint name="motor_4_joint" type="continuous">
    <parent link="base_link"/>
    <child link="motor_4"/>
    <origin xyz="-0.1075 -0.1075 0.03" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <!-- Camera Sensor -->
  <link name="camera_link">
    <visual>
      <geometry>
        <box size="0.05 0.05 0.03"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.05 0.05 0.03"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0"
               iyy="0.0001" iyz="0.0"
               izz="0.0001"/>
    </inertial>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="0.15 0 0.03" rpy="0 0 0"/>
  </joint>

  <!-- IMU Sensor -->
  <link name="imu_link">
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="0.00001" ixy="0.0" ixz="0.0"
               iyy="0.00001" iyz="0.0"
               izz="0.00001"/>
    </inertial>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>



</robot>